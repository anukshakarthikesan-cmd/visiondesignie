# Rename to `.env` next to docker-compose.yml for `docker compose` build args (frontend only).
# Backend still uses `backend/.env` (see docker-compose.yml env_file).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Browser must reach the API; use your public host in real deploys.
VITE_CHAT_API_BASE=http://localhost:8000
