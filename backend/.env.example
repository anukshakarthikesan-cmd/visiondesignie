# Copy to .env and fill. Never commit .env.

# production | development — production hides /docs unless ENABLE_OPENAPI_DOCS is set
# ENVIRONMENT=production
# ENABLE_OPENAPI_DOCS=true

# POST /chat requests per IP (SlowAPI). Set CHAT_RATE_LIMIT=disabled to turn off.
# CHAT_RATE_LIMIT=60/minute

# Required for /chat (Groq)
GROQ_API_KEY=

# Browser origins allowed to call this API with credentials (comma-separated).
# Defaults in code: http://127.0.0.1:5173,http://localhost:5173 if unset.
# Production: REQUIRED — browsers block requests if your frontend origin is not listed here.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://your-app.example.com
# Optional regex for preview deploys (example Vercel previews):
# CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional: server-side inserts into public.rag_query_metrics (Supabase service role only).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Deploy checklist (VisionDesignie RAG + LLM) ---
# 1. GROQ_API_KEY — without it POST /chat returns a clear SSE message; GET /health shows groq_configured false.
# 2. Deploy backend/data/vector_store/index.faiss + index.pkl (built via create_vector_store); else retrieval is skipped (LLM-only).
# 3. ENVIRONMENT=production + CORS_ORIGINS matching your hosted frontend (see DEPLOYMENT_GUIDE.md).
# 4. First retrieval downloads HuggingFace embeddings (~90MB CPU); allow outbound network or warm the instance.
# PREWARM_VECTORSTORE=true  # optional: load FAISS at startup (more RAM; faster first RAG query)
